@prefix adm: <http://example.com/meta/> .
@prefix ado: <http://example.com/ontology/> .
@prefix adr: <http://example.com/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

adm:sourceChunk a owl:AnnotationProperty .

adm:sourceQuote a owl:AnnotationProperty .

ado:appliesBom a owl:ObjectProperty ;
    rdfs:label "적용 BOM 개정"@ko ;
    rdfs:comment "작업지시에 적용된 BOM 개정을 나타낸다."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range ado:Bom .

ado:appliesSpecification a owl:ObjectProperty ;
    rdfs:label "적용 사양서 개정"@ko ;
    rdfs:comment "작업지시에 적용된 제품사양서 개정을 나타낸다."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range ado:ProductSpecification .

ado:completedAt a owl:DatatypeProperty ;
    rdfs:label "실제 완료일시"@ko ;
    rdfs:comment "작업지시의 실제 완료일시."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:dateTime .

ado:definesInspectionItem a owl:ObjectProperty ;
    rdfs:label "검사항목 정의"@ko ;
    rdfs:comment "제품사양서가 정의하는 검사항목을 나타낸다."@ko ;
    rdfs:domain ado:ProductSpecification ;
    rdfs:range ado:InspectionItem .

ado:forMaterial a owl:ObjectProperty ;
    rdfs:label "입고 자재"@ko ;
    rdfs:comment "자재 입고 로트가 해당하는 자재 품목을 나타낸다."@ko ;
    rdfs:domain ado:MaterialLot ;
    rdfs:range ado:Material .

ado:forProduct a owl:ObjectProperty ;
    rdfs:label "생산 대상 제품"@ko ;
    rdfs:comment "작업지시가 생산하는 제품을 나타낸다."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range ado:Product .

ado:forWorkOrder a owl:ObjectProperty ;
    rdfs:label "검사 대상 작업지시"@ko ;
    rdfs:comment "검사 기록이 속한 작업지시를 나타낸다."@ko ;
    rdfs:domain ado:Inspection ;
    rdfs:range ado:WorkOrder .

ado:hasBomId a owl:DatatypeProperty ;
    rdfs:label "BOM 번호"@ko ;
    rdfs:comment "BOM을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Bom ;
    rdfs:range xsd:string .

ado:hasBomRevision a owl:DatatypeProperty ;
    rdfs:label "BOM 개정"@ko ;
    rdfs:comment "BOM의 개정번호."@ko ;
    rdfs:domain ado:Bom ;
    rdfs:range xsd:string .

ado:hasConsumedQuantity a owl:DatatypeProperty ;
    rdfs:label "실제 투입량"@ko ;
    rdfs:comment "자재 투입 기록의 실제 투입 수량."@ko ;
    rdfs:domain ado:MaterialConsumption ;
    rdfs:range xsd:integer .

ado:hasDepartmentId a owl:DatatypeProperty ;
    rdfs:label "조직 코드"@ko ;
    rdfs:comment "조직을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Department ;
    rdfs:range xsd:string .

ado:hasDepartmentName a owl:DatatypeProperty ;
    rdfs:label "조직명"@ko ;
    rdfs:comment "조직에 부여된 명칭."@ko ;
    rdfs:domain ado:Department ;
    rdfs:range xsd:string .

ado:hasDeviceId a owl:DatatypeProperty ;
    rdfs:label "시리얼번호"@ko ;
    rdfs:comment "장치를 고유하게 식별하는 값, 시리얼번호."@ko ;
    rdfs:domain ado:Device ;
    rdfs:range xsd:string .

ado:hasEmployeeId a owl:DatatypeProperty ;
    rdfs:label "사번"@ko ;
    rdfs:comment "사람을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Employee ;
    rdfs:range xsd:string .

ado:hasEmployeeName a owl:DatatypeProperty ;
    rdfs:label "성명"@ko ;
    rdfs:comment "사람에 부여된 명칭."@ko ;
    rdfs:domain ado:Employee ;
    rdfs:range xsd:string .

ado:hasHeldQuantity a owl:DatatypeProperty ;
    rdfs:label "보류 대상 수량"@ko ;
    rdfs:comment "품질 보류의 대상 수량."@ko ;
    rdfs:domain ado:QualityHold ;
    rdfs:range xsd:integer .

ado:hasHoldReason a owl:DatatypeProperty ;
    rdfs:label "보류 사유"@ko ;
    rdfs:comment "품질 보류의 사유로, 미확정 원인은 단정하지 않은 내용."@ko ;
    rdfs:domain ado:QualityHold ;
    rdfs:range xsd:string .

ado:hasHoldStatus a owl:DatatypeProperty ;
    rdfs:label "보류 상태"@ko ;
    rdfs:comment "품질 보류 기록의 상태."@ko ;
    rdfs:domain ado:QualityHold ;
    rdfs:range xsd:string .

ado:hasInspectionFailedQuantity a owl:DatatypeProperty ;
    rdfs:label "검사 불합격 수량"@ko ;
    rdfs:comment "기준일시 현재 검사에서 불합격한 수량."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:integer .

ado:hasInspectionId a owl:DatatypeProperty ;
    rdfs:label "검사번호"@ko ;
    rdfs:comment "검사 기록을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Inspection ;
    rdfs:range xsd:string .

ado:hasInspectionItemCriteria a owl:DatatypeProperty ;
    rdfs:label "시험 조건/합격 기준"@ko ;
    rdfs:comment "검사항목의 시험 조건과 합격 기준."@ko ;
    rdfs:domain ado:InspectionItem ;
    rdfs:range xsd:string .

ado:hasInspectionItemId a owl:DatatypeProperty ;
    rdfs:label "검사항목 코드"@ko ;
    rdfs:comment "검사항목을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:InspectionItem ;
    rdfs:range xsd:string .

ado:hasInspectionItemName a owl:DatatypeProperty ;
    rdfs:label "검사항목명"@ko ;
    rdfs:comment "검사항목에 부여된 명칭."@ko ;
    rdfs:domain ado:InspectionItem ;
    rdfs:range xsd:string .

ado:hasInspectionPassedQuantity a owl:DatatypeProperty ;
    rdfs:label "검사 합격 수량"@ko ;
    rdfs:comment "기준일시 현재 검사에 합격한 수량."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:integer .

ado:hasInspectionResult a owl:DatatypeProperty ;
    rdfs:label "판정"@ko ;
    rdfs:comment "검사 결과의 판정, 합격 또는 불합격."@ko ;
    rdfs:domain ado:InspectionResult ;
    rdfs:range xsd:string .

ado:hasInspectionResultId a owl:DatatypeProperty ;
    rdfs:label "검사 결과 식별자"@ko ;
    rdfs:comment "검사 결과를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:InspectionResult ;
    rdfs:range xsd:string .

ado:hasMachineId a owl:DatatypeProperty ;
    rdfs:label "설비 코드"@ko ;
    rdfs:comment "설비를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Machine ;
    rdfs:range xsd:string .

ado:hasMachineName a owl:DatatypeProperty ;
    rdfs:label "설비명"@ko ;
    rdfs:comment "설비에 부여된 명칭."@ko ;
    rdfs:domain ado:Machine ;
    rdfs:range xsd:string .

ado:hasMaterialConsumptionId a owl:DatatypeProperty ;
    rdfs:label "투입 기록번호"@ko ;
    rdfs:comment "자재 투입 기록을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:MaterialConsumption ;
    rdfs:range xsd:string .

ado:hasMaterialId a owl:DatatypeProperty ;
    rdfs:label "자재코드"@ko ;
    rdfs:comment "자재를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Material ;
    rdfs:range xsd:string .

ado:hasMaterialLotId a owl:DatatypeProperty ;
    rdfs:label "입고 로트번호"@ko ;
    rdfs:comment "자재 입고 로트를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:MaterialLot ;
    rdfs:range xsd:string .

ado:hasMaterialLotStatus a owl:DatatypeProperty ;
    rdfs:label "입고 로트 상태"@ko ;
    rdfs:comment "자재 입고 로트의 상태, 사용 보류 포함."@ko ;
    rdfs:domain ado:MaterialLot ;
    rdfs:range xsd:string .

ado:hasMaterialName a owl:DatatypeProperty ;
    rdfs:label "자재명/규격"@ko ;
    rdfs:comment "자재에 부여된 명칭과 규격."@ko ;
    rdfs:domain ado:Material ;
    rdfs:range xsd:string .

ado:hasMaterialType a owl:DatatypeProperty ;
    rdfs:label "품목 유형"@ko ;
    rdfs:comment "자재의 품목 유형, 반제품·부품·부자재."@ko ;
    rdfs:domain ado:Material ;
    rdfs:range xsd:string .

ado:hasMeasuredValue a owl:DatatypeProperty ;
    rdfs:label "측정값"@ko ;
    rdfs:comment "검사 결과에서 장치를 측정해 얻은 값."@ko ;
    rdfs:domain ado:InspectionResult ;
    rdfs:range xsd:decimal .

ado:hasPlannedQuantity a owl:DatatypeProperty ;
    rdfs:label "계획(지시) 수량"@ko ;
    rdfs:comment "작업지시의 계획 수량, 지시 수량."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:integer .

ado:hasProducedQuantity a owl:DatatypeProperty ;
    rdfs:label "생산 수량"@ko ;
    rdfs:comment "기준일시 현재 작업지시의 생산 수량."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:integer .

ado:hasProductId a owl:DatatypeProperty ;
    rdfs:label "제품코드"@ko ;
    rdfs:comment "제품을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Product ;
    rdfs:range xsd:string .

ado:hasProductName a owl:DatatypeProperty ;
    rdfs:label "모델명"@ko ;
    rdfs:comment "제품에 부여된 명칭."@ko ;
    rdfs:domain ado:Product ;
    rdfs:range xsd:string .

ado:hasProductSpecificationId a owl:DatatypeProperty ;
    rdfs:label "사양서 번호"@ko ;
    rdfs:comment "제품사양서를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:ProductSpecification ;
    rdfs:range xsd:string .

ado:hasProductSpecificationRevision a owl:DatatypeProperty ;
    rdfs:label "개정번호"@ko ;
    rdfs:comment "제품사양서의 개정번호."@ko ;
    rdfs:domain ado:ProductSpecification ;
    rdfs:range xsd:string .

ado:hasProductionLotId a owl:DatatypeProperty ;
    rdfs:label "생산 로트번호"@ko ;
    rdfs:comment "생산 로트를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:ProductionLot ;
    rdfs:range xsd:string .

ado:hasQualityHoldId a owl:DatatypeProperty ;
    rdfs:label "보류 기록번호"@ko ;
    rdfs:comment "품질 보류 기록을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:QualityHold ;
    rdfs:range xsd:string .

ado:hasQuantityPerUnit a owl:DatatypeProperty ;
    rdfs:label "기준 소요량"@ko ;
    rdfs:comment "제품 1대당 필요한 구성품의 기준 소요량."@ko ;
    rdfs:domain ado:Bom ;
    rdfs:range xsd:decimal .

ado:hasReceivedQuantity a owl:DatatypeProperty ;
    rdfs:label "입고량"@ko ;
    rdfs:comment "자재 입고 로트의 입고 수량."@ko ;
    rdfs:domain ado:MaterialLot ;
    rdfs:range xsd:integer .

ado:hasReferenceValue a owl:DatatypeProperty ;
    rdfs:label "기준값"@ko ;
    rdfs:comment "검사항목 판정에 사용하는 기준점 값."@ko ;
    rdfs:domain ado:InspectionItem ;
    rdfs:range xsd:decimal .

ado:hasReworkId a owl:DatatypeProperty ;
    rdfs:label "조치기록번호"@ko ;
    rdfs:comment "재작업 기록을 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Rework ;
    rdfs:range xsd:string .

ado:hasShipmentApprovedQuantity a owl:DatatypeProperty ;
    rdfs:label "출하 승인 수량"@ko ;
    rdfs:comment "출하 승인을 받은 수량으로, 품질 보류 중인 검사 합격품은 포함하지 않는다."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:integer .

ado:hasSupplierId a owl:DatatypeProperty ;
    rdfs:label "공급업체 코드"@ko ;
    rdfs:comment "공급업체를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:Supplier ;
    rdfs:range xsd:string .

ado:hasSupplierName a owl:DatatypeProperty ;
    rdfs:label "공급업체명"@ko ;
    rdfs:comment "공급업체에 부여된 명칭."@ko ;
    rdfs:domain ado:Supplier ;
    rdfs:range xsd:string .

ado:hasTolerance a owl:DatatypeProperty ;
    rdfs:label "허용 오차"@ko ;
    rdfs:comment "검사항목 판정에서 허용되는 오차."@ko ;
    rdfs:domain ado:InspectionItem ;
    rdfs:range xsd:decimal .

ado:hasUnit a owl:DatatypeProperty ;
    rdfs:label "단위"@ko ;
    rdfs:comment "기준 소요량의 단위."@ko ;
    rdfs:domain ado:Bom ;
    rdfs:range xsd:string .

ado:hasUnproducedQuantity a owl:DatatypeProperty ;
    rdfs:label "미생산 수량"@ko ;
    rdfs:comment "지시 수량에서 생산 수량을 제외한 미생산 수량."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:integer .

ado:hasWorkOrderId a owl:DatatypeProperty ;
    rdfs:label "작업지시번호"@ko ;
    rdfs:comment "작업지시를 고유하게 식별하는 값."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:string .

ado:hasWorkOrderReferenceAt a owl:DatatypeProperty ;
    rdfs:label "기준일시"@ko ;
    rdfs:comment "작업지시의 현재 상태와 수량이 적용되는 기준일시."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:dateTime .

ado:hasWorkOrderStatus a owl:DatatypeProperty ;
    rdfs:label "작업 상태"@ko ;
    rdfs:comment "기준일시 현재 작업지시의 상태."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:string .

ado:heldMaterialLot a owl:ObjectProperty ;
    rdfs:label "보류 입고 로트"@ko ;
    rdfs:comment "품질 보류의 대상 자재 입고 로트를 나타낸다."@ko ;
    rdfs:domain ado:QualityHold ;
    rdfs:range ado:MaterialLot .

ado:heldProductionLot a owl:ObjectProperty ;
    rdfs:label "보류 생산 로트"@ko ;
    rdfs:comment "품질 보류의 대상 생산 로트를 나타낸다."@ko ;
    rdfs:domain ado:QualityHold ;
    rdfs:range ado:ProductionLot .

ado:heldWorkOrder a owl:ObjectProperty ;
    rdfs:label "보류 작업지시"@ko ;
    rdfs:comment "품질 보류가 영향을 미치는 작업지시를 나타낸다."@ko ;
    rdfs:domain ado:QualityHold ;
    rdfs:range ado:WorkOrder .

ado:inProductionLot a owl:ObjectProperty ;
    rdfs:label "소속 생산 로트"@ko ;
    rdfs:comment "장치가 속한 생산 로트를 나타낸다."@ko ;
    rdfs:domain ado:Device ;
    rdfs:range ado:ProductionLot .

ado:inspectedAt a owl:DatatypeProperty ;
    rdfs:label "검사 일시"@ko ;
    rdfs:comment "검사 기록의 수행 일시."@ko ;
    rdfs:domain ado:Inspection ;
    rdfs:range xsd:dateTime .

ado:listsMaterial a owl:ObjectProperty ;
    rdfs:label "BOM 구성품"@ko ;
    rdfs:comment "BOM에 포함된 구성품 자재를 나타낸다."@ko ;
    rdfs:domain ado:Bom ;
    rdfs:range ado:Material .

ado:listsProduct a owl:ObjectProperty ;
    rdfs:label "BOM 대상 제품"@ko ;
    rdfs:comment "BOM이 구성을 정의하는 제품을 나타낸다."@ko ;
    rdfs:domain ado:Bom ;
    rdfs:range ado:Product .

ado:ofDevice a owl:ObjectProperty ;
    rdfs:label "검사 결과 대상 장치"@ko ;
    rdfs:comment "검사 결과가 판정한 대상 장치를 나타낸다."@ko ;
    rdfs:domain ado:InspectionResult ;
    rdfs:range ado:Device .

ado:ofInspection a owl:ObjectProperty ;
    rdfs:label "검사 결과 대상 검사"@ko ;
    rdfs:comment "검사 결과가 속한 검사 기록을 나타낸다."@ko ;
    rdfs:domain ado:InspectionResult ;
    rdfs:range ado:Inspection .

ado:ofInspectionItem a owl:ObjectProperty ;
    rdfs:label "검사 결과 대상 항목"@ko ;
    rdfs:comment "검사 결과가 적용된 검사항목을 나타낸다."@ko ;
    rdfs:domain ado:InspectionResult ;
    rdfs:range ado:InspectionItem .

ado:ofMaterialLot a owl:ObjectProperty ;
    rdfs:label "투입 입고 로트"@ko ;
    rdfs:comment "자재 투입 기록이 투입한 자재 입고 로트를 나타낸다."@ko ;
    rdfs:domain ado:MaterialConsumption ;
    rdfs:range ado:MaterialLot .

ado:ofWorkOrder a owl:ObjectProperty ;
    rdfs:label "투입 작업지시"@ko ;
    rdfs:comment "자재 투입이 수행된 작업지시를 나타낸다."@ko ;
    rdfs:domain ado:MaterialConsumption ;
    rdfs:range ado:WorkOrder .

ado:performedBy a owl:ObjectProperty ;
    rdfs:label "담당자"@ko ;
    rdfs:comment "작업지시를 수행한 담당자를 나타낸다."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range ado:Employee .

ado:performedOnMachine a owl:ObjectProperty ;
    rdfs:label "사용 설비"@ko ;
    rdfs:comment "작업지시 수행에 사용된 설비를 나타낸다."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range ado:Machine .

ado:plannedCompletionAt a owl:DatatypeProperty ;
    rdfs:label "예정 완료일시"@ko ;
    rdfs:comment "작업지시의 예정 완료일시."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range xsd:dateTime .

ado:producesLot a owl:ObjectProperty ;
    rdfs:label "생산 로트 지정"@ko ;
    rdfs:comment "작업지시가 생산하는 생산 로트를 나타낸다."@ko ;
    rdfs:domain ado:WorkOrder ;
    rdfs:range ado:ProductionLot .

ado:referencesInitialInspection a owl:ObjectProperty ;
    rdfs:label "재작업 참조 검사"@ko ;
    rdfs:comment "재작업의 근거가 된 최초 검사 기록을 나타낸다."@ko ;
    rdfs:domain ado:Rework ;
    rdfs:range ado:Inspection .

ado:referencesInspection a owl:ObjectProperty ;
    rdfs:label "참조 검사번호"@ko ;

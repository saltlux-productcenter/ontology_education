@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ado: <http://example.com/ontology/> .
@prefix adr: <http://example.com/resource/> .
@prefix ns1: <http://www.w3.org/ns/prov#> .

<http://example.com/ontology> a owl:Ontology;
  rdfs:label "제조온톨로지";
  rdfs:comment "제조온톨로지";
  owl:versionIRI <http://example.com/ontology/2.0.0>; owl:versionInfo "2.0.0" .

ado:ProductionLot a owl:Class;
  rdfs:label "생산 로트"@ko;
  rdfs:comment "동일한 생산 공정이나 조건에 따라 함께 제조된 제품의 묶음."@ko;
  rdfs:subClassOf ns1:Collection .

ado:WorkOrder a owl:Class;
  rdfs:label "작업 지시"@ko;
  rdfs:comment "제품 생산을 위해 수행할 작업의 내용과 상태를 기록한 지시."@ko;
  rdfs:subClassOf ns1:Plan .

ado:Product a owl:Class;
  rdfs:label "제품"@ko;
  rdfs:comment "제품 품목의 종류를 나타내는 마스터 항목. 개별 제조품은 ManufacturedUnit으로 구분한다."@ko;
  rdfs:subClassOf ado:Item .

ado:Machine a owl:Class;
  rdfs:label "설비"@ko;
  rdfs:comment "제조 작업에 사용되는 기계 또는 생산 설비."@ko;
  rdfs:subClassOf ns1:Entity .

ado:Employee a owl:Class;
  rdfs:label "직원"@ko;
  rdfs:comment "제조 또는 검사 업무를 수행하는 조직 구성원."@ko;
  rdfs:subClassOf ns1:Person .

ado:Department a owl:Class;
  rdfs:label "부서"@ko;
  rdfs:comment "직원이 소속되어 업무를 수행하는 조직 단위."@ko;
  rdfs:subClassOf ns1:Organization .

ado:Inspection a owl:Class;
  rdfs:label "검사"@ko;
  rdfs:comment "생산 로트의 품질이나 적합성을 평가한 활동 및 기록."@ko;
  rdfs:subClassOf ns1:Activity .

ado:MaterialConsumption a owl:Class;
  rdfs:label "자재 소비"@ko;
  rdfs:comment "생산 과정에서 특정 자재 로트가 사용된 내역."@ko;
  rdfs:subClassOf ado:MaterialAllocation .

ado:MaterialLot a owl:Class;
  rdfs:label "자재 로트"@ko;
  rdfs:comment "동일한 입고 또는 생산 조건으로 관리되는 자재의 묶음."@ko;
  rdfs:subClassOf ns1:Collection .

ado:Material a owl:Class;
  rdfs:label "자재"@ko;
  rdfs:comment "자재 품목의 종류를 나타내는 마스터 항목. 실제 입고 묶음은 MaterialLot으로 구분한다."@ko;
  rdfs:subClassOf ado:Item .

ado:Supplier a owl:Class;
  rdfs:label "공급업체"@ko;
  rdfs:comment "생산에 필요한 자재를 공급하는 조직."@ko;
  rdfs:subClassOf ns1:Organization .

ns1:Collection a owl:Class;
  rdfs:subClassOf ns1:Entity .

ns1:Entity a owl:Class .

ns1:Plan a owl:Class;
  rdfs:subClassOf ns1:Entity .

ns1:Person a owl:Class;
  rdfs:subClassOf ns1:Agent .

ns1:Agent a owl:Class .

ns1:Organization a owl:Class;
  rdfs:subClassOf ns1:Agent .

ns1:Activity a owl:Class .

ado:hasProductionLotId a owl:DatatypeProperty;
  rdfs:label "생산 로트 식별자"@ko;
  rdfs:comment "생산 로트를 고유하게 식별하는 값."@ko;
  rdfs:domain ado:ProductionLot;
  rdfs:range xsd:string .

ado:generatedFromWorkOrder a owl:ObjectProperty;
  rdfs:label "생성 근거 작업 지시"@ko;
  rdfs:comment "생산 로트가 어떤 작업 지시에 따라 생성되었는지를 나타낸다."@ko;
  rdfs:domain ado:ProductionLot;
  rdfs:range ado:WorkOrder .

ado:manufacturedOnMachine a owl:ObjectProperty;
  rdfs:label "제조 설비"@ko;
  rdfs:comment "생산 로트가 제조된 설비를 나타낸다."@ko;
  rdfs:domain ado:ProductionLot;
  rdfs:range ado:Machine .

ado:hasWorkOrderId a owl:DatatypeProperty;
  rdfs:label "작업 지시 식별자"@ko;
  rdfs:comment "작업 지시를 고유하게 식별하는 값."@ko;
  rdfs:domain ado:WorkOrder;
  rdfs:range xsd:string .

ado:producesProduct a owl:ObjectProperty;
  rdfs:label "생산 제품"@ko;
  rdfs:comment "작업 지시를 통해 생산하도록 지정된 제품을 나타낸다."@ko;
  rdfs:domain ado:WorkOrder;
  rdfs:range ado:Product .

ado:operatedByEmployee a owl:ObjectProperty;
  rdfs:label "작업 담당 직원"@ko;
  rdfs:comment "작업 지시를 수행하거나 설비를 운전한 직원을 나타낸다."@ko;
  rdfs:domain ado:WorkOrder;
  rdfs:range ado:Employee .

ado:hasWorkOrderStatus a owl:DatatypeProperty;
  rdfs:label "작업 지시 상태"@ko;
  rdfs:comment "작업 지시의 현재 진행 상태를 나타낸다."@ko;
  rdfs:domain ado:WorkOrder;
  rdfs:range xsd:string .

ado:hasProductId a owl:DatatypeProperty;
  rdfs:label "제품 식별자"@ko;
  rdfs:comment "제품을 고유하게 식별하는 값."@ko;
  rdfs:domain ado:Product;
  rdfs:range xsd:string .

ado:hasProductName a owl:DatatypeProperty;
  rdfs:label "제품명"@ko;
  rdfs:comment "제품에 부여된 명칭."@ko;
  rdfs:domain ado:Product;
  rdfs:range xsd:string .

ado:hasMachineId a owl:DatatypeProperty;
  rdfs:label "설비 식별자"@ko;
  rdfs:comment "설비를 고유하게 식별하는 값."@ko;
  rdfs:domain ado:Machine;
  rdfs:range xsd:string .

ado:hasMachineName a owl:DatatypeProperty;
  rdfs:label "설비명"@ko;
  rdfs:comment "설비에 부여된 명칭."@ko;
  rdfs:domain ado:Machine;
  rdfs:range xsd:string .

ado:hasEmployeeId a owl:DatatypeProperty;
  rdfs:label "직원 식별자"@ko;
  rdfs:comment "직원을 고유하게 식별하는 값."@ko;
  rdfs:domain ado:Employee;
  rdfs:range xsd:string .

ado:hasEmployeeName a owl:DatatypeProperty;
  rdfs:label "직원명"@ko;
  rdfs:comment "직원의 이름."@ko;
  rdfs:domain ado:Employee;
  rdfs:range xsd:string .

ado:belongsToDepartment a owl:ObjectProperty;
  rdfs:label "소속 부서"@ko;
  rdfs:comment "직원이 소속된 부서를 나타낸다."@ko;
  rdfs:domain ado:Employee;
  rdfs:range ado:Department;
  owl:inverseOf ado:hasDepartmentMember .

ado:hasDepartmentName a owl:DatatypeProperty;
  rdfs:label "부서명"@ko;
  rdfs:comment "부서에 부여된 명칭."@ko;
  rdfs:domain ado:Department;
  rdfs:range xsd:string .

ado:hasDepartmentMember a owl:ObjectProperty;
  rdfs:label "부서 구성원"@ko;
  rdfs:comment "부서에 소속된 직원을 나타낸다."@ko;
  rdfs:domain ado:Department;
  rdfs:range ado:Employee .

ado:hasInspectionId a owl:DatatypeProperty;
  rdfs:label "검사 식별자"@ko;
  rdfs:comment "검사 기록을 고유하게 식별하는 값."@ko;
  rdfs:domain ado:Inspection;
  rdfs:range xsd:string .

ado:evaluatesProductionLot a owl:ObjectProperty;
  rdfs:label "평가 대상 생산 로트"@ko;
  rdfs:comment "검사에서 평가한 생산 로트를 나타낸다."@ko;
  rdfs:domain ado:Inspection;
  rdfs:range ado:ProductionLot .

ado:inspectedAt a owl:DatatypeProperty;
  rdfs:label "검사 일시"@ko;
  rdfs:comment "검사가 수행된 날짜와 시각."@ko;
  rdfs:domain ado:Inspection;
  rdfs:range xsd:dateTime .

ado:hasInspectionResult a owl:DatatypeProperty;
  rdfs:label "검사 결과"@ko;
  rdfs:comment "검사에서 판정되거나 기록된 결과."@ko;
  rdfs:domain ado:Inspection;
  rdfs:range xsd:string .

ado:linkedFailureInspection a owl:ObjectProperty;
  rdfs:label "연계된 불합격 검사"@ko;
  rdfs:comment "생산 로트와 관련된 불합격 검사 기록을 나타낸다."@ko;
  rdfs:domain ado:ProductionLot;
  rdfs:range ado:Inspection .

ado:hasConsumptionId a owl:DatatypeProperty;
  rdfs:label "자재 소비 식별자"@ko;
  rdfs:comment "자재 소비 내역을 고유하게 식별하는 값."@ko;
  rdfs:domain ado:MaterialConsumption;
  rdfs:range xsd:string .

ado:consumedForProductionLot a owl:ObjectProperty;
  rdfs:label "소비 대상 생산 로트"@ko;
  rdfs:comment "자재가 사용된 생산 로트를 나타낸다."@ko;
  rdfs:domain ado:MaterialConsumption;
  rdfs:range ado:ProductionLot .

ado:consumesMaterialLot a owl:ObjectProperty;
  rdfs:label "소비된 자재 로트"@ko;
  rdfs:comment "생산 과정에서 사용된 자재 로트를 나타낸다."@ko;
  rdfs:domain ado:MaterialConsumption;
  rdfs:range ado:MaterialLot .

ado:hasMaterialLotId a owl:DatatypeProperty;
  rdfs:label "자재 로트 식별자"@ko;
  rdfs:comment "자재 로트를 고유하게 식별하는 값."@ko;
  rdfs:domain ado:MaterialLot;
  rdfs:range xsd:string .

ado:identifiesMaterial a owl:ObjectProperty;
  rdfs:label "해당 자재"@ko;
  rdfs:comment "자재 로트가 어떤 자재에 해당하는지를 나타낸다."@ko;
  rdfs:domain ado:MaterialLot;
  rdfs:range ado:Material .

ado:suppliedBySupplier a owl:ObjectProperty;
  rdfs:label "자재 로트 공급업체"@ko;
  rdfs:comment "자재 로트를 공급한 업체를 나타낸다."@ko;
  rdfs:domain ado:MaterialLot;
  rdfs:range ado:Supplier .

ado:hasMaterialId a owl:DatatypeProperty;
  rdfs:label "자재 식별자"@ko;
  rdfs:comment "자재를 고유하게 식별하는 값."@ko;
  rdfs:domain ado:Material;
  rdfs:range xsd:string .

ado:hasMaterialName a owl:DatatypeProperty;
  rdfs:label "자재명"@ko;
  rdfs:comment "자재에 부여된 명칭."@ko;
  rdfs:domain ado:Material;
  rdfs:range xsd:string .

ado:hasSupplierId a owl:DatatypeProperty;
  rdfs:label "공급업체 식별자"@ko;
  rdfs:comment "공급업체를 고유하게 식별하는 값."@ko;
  rdfs:domain ado:Supplier;
  rdfs:range xsd:string .

ado:hasSupplierName a owl:DatatypeProperty;
  rdfs:label "공급업체명"@ko;
  rdfs:comment "공급업체에 부여된 명칭."@ko;
  rdfs:domain ado:Supplier;
  rdfs:range xsd:string .

ado:SourceDocument a owl:Class; rdfs:label "출처 문서"@ko; rdfs:subClassOf ns1:Entity .
ado:Item a owl:Class; rdfs:label "품목"@ko; rdfs:subClassOf ns1:Entity .
ado:ProductSpecification a owl:Class; rdfs:label "제품 사양서"@ko; rdfs:subClassOf ns1:Entity .
ado:BillOfMaterials a owl:Class; rdfs:label "자재 명세서"@ko; rdfs:subClassOf ns1:Entity .
ado:BOMLine a owl:Class; rdfs:label "BOM 구성 행"@ko; rdfs:subClassOf ns1:Entity .
ado:Firmware a owl:Class; rdfs:label "펌웨어"@ko; rdfs:subClassOf ns1:Entity .
ado:InspectionCriterion a owl:Class; rdfs:label "검사 기준 항목"@ko; rdfs:subClassOf ns1:Entity .
ado:InspectionResultRow a owl:Class; rdfs:label "검사항목별 결과 행"@ko; rdfs:subClassOf ns1:Entity .
ado:ManufacturedUnit a owl:Class; rdfs:label "시리얼이 확인된 개별 제품"@ko; rdfs:subClassOf ns1:Entity .
ado:WorkOrderStep a owl:Class; rdfs:label "작업지시별 공정 단계 기록"@ko; rdfs:subClassOf ns1:Entity .
ado:MaterialAllocation a owl:Class; rdfs:label "자재 배정 및 투입 기록"@ko; rdfs:subClassOf ns1:Activity .
ado:QualityAction a owl:Class; rdfs:label "품질 조치"@ko; rdfs:subClassOf ns1:Activity .
ado:Rework a owl:Class; rdfs:label "재작업"@ko; rdfs:subClassOf ado:QualityAction .
ado:QualityHold a owl:Class; rdfs:label "품질 보류"@ko; rdfs:subClassOf ado:QualityAction .
ado:Item rdfs:comment "제품·자재의 종류와 규격을 관리하는 품목마스터 항목. 개별 제품 및 입고 로트와 구분한다."@ko .
ado:ProductSpecification rdfs:comment "제품과 적용 BOM·펌웨어·검사 기준을 특정 개정으로 묶은 승인 사양."@ko .
ado:BillOfMaterials rdfs:comment "특정 개정의 제품 구성표. 수량·공정·승인 공급업체는 구성 행에서 정의한다."@ko .
ado:BOMLine rdfs:comment "BOM 개정 안의 자재별 구성 행. 제품 1대당 소요량과 승인 공급업체의 적용 범위를 보존한다."@ko .
ado:InspectionResultRow rdfs:comment "검사번호 안의 검사항목·측정항목·대상별 기록. 동일 장치가 여러 행에 나타날 수 있다."@ko .
ado:ManufacturedUnit rdfs:comment "원문에서 시리얼번호가 개별적으로 확인된 제품 1대."@ko .
ado:WorkOrderStep rdfs:comment "작업지시서 공정표의 한 행을 나타내는 기록. 지시 내용과 실제 수행 기록을 구분하며, 미착수·보류 단계도 포함한다."@ko .
ado:QualityHold rdfs:comment "조사 또는 승인 전까지 생산·사용·출하를 중지한 조치. 자재 로트가 원인이라는 뜻은 아니다."@ko .
ado:MaterialAllocation rdfs:comment "계획 수량과 실제 투입량을 함께 기록한다. 실제 투입량 0은 소비가 없음을 뜻한다."@ko .

ado:sourceFileName a owl:DatatypeProperty; rdfs:label "출처 파일명"@ko; rdfs:domain ado:SourceDocument; rdfs:range xsd:string .
ado:sourceDocument a owl:ObjectProperty; rdfs:label "근거 문서"@ko; rdfs:domain owl:Thing; rdfs:range ado:SourceDocument .
ado:specificationId a owl:DatatypeProperty; rdfs:label "사양서 번호"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:string .
ado:specificationRevision a owl:DatatypeProperty; rdfs:label "사양서 개정"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:string .
ado:approvedOn a owl:DatatypeProperty; rdfs:label "승인일"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:date .
ado:effectiveOn a owl:DatatypeProperty; rdfs:label "적용일"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:date .
ado:specifiesProduct a owl:ObjectProperty; rdfs:label "사양 적용 제품"@ko; rdfs:domain ado:ProductSpecification; rdfs:range ado:Product .
ado:specifiesBOM a owl:ObjectProperty; rdfs:label "사양 적용 BOM"@ko; rdfs:domain ado:ProductSpecification; rdfs:range ado:BillOfMaterials .
ado:specifiesFirmware a owl:ObjectProperty; rdfs:label "사양 적용 펌웨어"@ko; rdfs:domain ado:ProductSpecification; rdfs:range ado:Firmware .
ado:inputVoltageNominalV a owl:DatatypeProperty; rdfs:label "정격 입력 전압 V"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:inputVoltageTolerancePercent a owl:DatatypeProperty; rdfs:label "입력 전압 허용 편차 %"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:operatingCurrentMaxMilliamp a owl:DatatypeProperty; rdfs:label "최대 정상 동작 전류 mA"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:operatingTemperatureMinC a owl:DatatypeProperty; rdfs:label "사용 온도 하한 °C"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:operatingTemperatureMaxC a owl:DatatypeProperty; rdfs:label "사용 온도 상한 °C"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:operatingHumidityMinRH a owl:DatatypeProperty; rdfs:label "사용 상대습도 하한 %RH"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:operatingHumidityMaxRH a owl:DatatypeProperty; rdfs:label "사용 상대습도 상한 %RH"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:temperatureReferenceC a owl:DatatypeProperty; rdfs:label "검사 기준 온도 °C"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:humidityReferenceRH a owl:DatatypeProperty; rdfs:label "검사 기준 습도 %RH"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:temperatureToleranceC a owl:DatatypeProperty; rdfs:label "기준점 온도 허용 오차 °C"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:humidityTolerancePercentagePoint a owl:DatatypeProperty; rdfs:label "기준점 습도 허용 오차 %p"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:measurementPeriodSeconds a owl:DatatypeProperty; rdfs:label "측정 주기 초"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:integer .
ado:transmissionPeriodSeconds a owl:DatatypeProperty; rdfs:label "전송 주기 초"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:integer .
ado:wifiBandGHz a owl:DatatypeProperty; rdfs:label "Wi-Fi 대역 GHz"@ko; rdfs:domain ado:ProductSpecification; rdfs:range xsd:decimal .
ado:bomId a owl:DatatypeProperty; rdfs:label "BOM 번호"@ko; rdfs:domain ado:BillOfMaterials; rdfs:range xsd:string .
ado:bomRevision a owl:DatatypeProperty; rdfs:label "BOM 개정"@ko; rdfs:domain ado:BillOfMaterials; rdfs:range xsd:string .
ado:forProduct a owl:ObjectProperty; rdfs:label "BOM 대상 제품"@ko; rdfs:domain ado:BillOfMaterials; rdfs:range ado:Product .
ado:hasBOMLine a owl:ObjectProperty; rdfs:label "BOM의 구성 행"@ko; rdfs:domain ado:BillOfMaterials; rdfs:range ado:BOMLine .
ado:componentMaterial a owl:ObjectProperty; rdfs:label "구성 자재"@ko; rdfs:domain ado:BOMLine; rdfs:range ado:Material .
ado:quantityPerProduct a owl:DatatypeProperty; rdfs:label "제품 1대당 소요량"@ko; rdfs:domain ado:BOMLine; rdfs:range xsd:decimal .
